# ==============================================================================
# IT Infrastructure Documentation Generator - Configuration
# ==============================================================================

# Application Environment (development / production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Secrets (CHANGE FOR PRODUCTION)
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Admin Credentials (used on first initialization)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@infra-doc.local
ADMIN_PASSWORD=AdminStrongPassword123!

# PostgreSQL Database Configuration
POSTGRES_USER=infradoc
POSTGRES_PASSWORD=infradoc_secure_pass
POSTGRES_DB=infradoc_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://infradoc:infradoc_secure_pass@db:5432/infradoc_db
DATABASE_URL_SYNC=postgresql://infradoc:infradoc_secure_pass@db:5432/infradoc_db

# Local Ollama AI Runtime (Internal Network Only)
AI_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
AI_MODEL_NAME=qwen2.5-coder:7b
AI_TIMEOUT_SECONDS=120
AI_MAX_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=4096

# Storage Paths
STORAGE_DIR=/app/storage
TEMPLATES_DIR=/app/templates

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
